{
  "name": "@lyric-viewer/mobile",
  "version": "0.1.0",
  "description": "iOS (first) cross-platform Lyric Player, built with Expo/React Native + react-native-skia. Reuses @lyric-viewer/core for lyric matching, sync, word-timing, palette, and LLM-prompt logic.",
  "main": "index.js",
  "private": true,
  "scripts": {
    "build:core": "npm run build --workspace=@lyric-viewer/core",
    "prestart": "npm run build:core",
    "start": "expo start --dev-client",
    "prestart:go": "npm run build:core",
    "start:go": "expo start",
    "preios": "npm run build:core",
    "ios": "expo run:ios",
    "pretypecheck": "npm run build:core",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@lyric-viewer/core": "*",
    "@shopify/react-native-skia": "2.2.12",
    "expo": "54",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-preset-expo": "~54.0.0",
    "typescript": "^5.9.3"
  }
}
