{
  "expo": {
    "name": "Lyric Player",
    "slug": "lyric-player",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "scheme": "lyricplayer",
    "ios": {
      "bundleIdentifier": "com.example.lyricplayer",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Lyric Player reads what's currently playing in Apple Music to show synced lyrics.",
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "plugins": [
      "expo-dev-client",
      "./plugins/withNativeSources.js",
      "expo-asset",
      "expo-font"
    ]
  }
}
