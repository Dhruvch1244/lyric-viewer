{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Lyric Overlay",
  "version": "0.41.0",
  "identifier": "com.dhruv.lyricoverlay",
  "build": {
    "frontendDist": "../src/renderer",
    "beforeBuildCommand": "npm run vendor:whisper && npm run vendor:demucs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lyric Player",
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "app", "dmg", "deb", "rpm", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Dhruvch1244/lyric-viewer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM1M0E0NTc3Q0Q3OTFGMTIKUldRU0gzbk5kMFU2eFIzUXJQam1WZDJoQ252cFd6TE82TTROSm1CdFdwVDVIYXRMaVFQVFZJN0cK"
    }
  }
}
