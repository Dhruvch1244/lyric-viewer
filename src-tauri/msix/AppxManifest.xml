<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of Lyric Overlay.

  Identity MUST match the Partner Center reservation exactly (Product identity
  page) or the Store rejects the upload. Version is stamped from tauri.conf.json
  by scripts/build-msix.ps1 at pack time; the Revision (4th field) stays 0 —
  the Store reserves it.

  The app is a full-trust Win32 binary (WASAPI loopback, SMTC, wallpaper
  reparenting), packaged with EntryPoint="Windows.FullTrustApplication" and the
  runFullTrust restricted capability. Microsoft signs the package on ingestion,
  so this manifest is packed UNSIGNED for Store submission.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="DhruvChoudhary.LyricOverlay"
    Publisher="CN=96AC782F-5C01-4FEE-9316-A7B17837CEE4"
    Version="0.0.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Lyric Overlay</DisplayName>
    <PublisherDisplayName>Dhruv Choudhary</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="LyricOverlay" Executable="lyric-overlay.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Lyric Overlay"
        Description="Beat-aware synced lyric overlay and music visualizer for Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          ShortName="Lyric Overlay"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png">
          <uap:ShowNameOnTiles>
            <uap:ShowOn Tile="square150x150Logo" />
            <uap:ShowOn Tile="wide310x150Logo" />
            <uap:ShowOn Tile="square310x310Logo" />
          </uap:ShowNameOnTiles>
        </uap:DefaultTile>
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
