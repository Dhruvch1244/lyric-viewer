node_modules/
dist/
dist-installer/
out/

# Expo / Metro caches (regenerated on every `expo start`)
.expo/

# Secrets — API keys, never commit (see keys.js resolver + 🔑 panel)
secrets.js
src/main/secrets.js

# packages/core's dist/ IS committed (see packages/core/dist/README.md) —
# npm workspace scripts that build it before Metro starts have proven
# unreliable to trigger consistently (npx vs npm run, missed hooks), so the
# built output ships in git instead. Rebuild + recommit after any change to
# packages/core/src.
!packages/core/dist/
*.log
.DS_Store

# Machine-specific Claude Code local settings
.claude/settings.local.json
