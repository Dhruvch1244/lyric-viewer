node_modules/
dist/
dist-installer/
out/
*.log
.DS_Store

# Vendored Whisper runtime (transformers.js web + ort WASM) — large binaries
# copied from node_modules by scripts/vendor-whisper.js, not authored here.
src/renderer/vendor/transformers/

# Vendored onnxruntime-web for demucs.js (see scripts/vendor-demucs.js) — same
# reasoning, a large binary copied from node_modules, not authored here.
src/renderer/vendor/onnxruntime/

# Machine-specific Claude Code local settings
.claude/settings.local.json

# Promo stills are regenerated, not authored — keep them out of git.
promo/stills/

# Dead iOS/Expo port — the source lives on claude/lyric-viewer-ios-crossplatform-7fmjh1.
# What is left in the working tree is an install dir, not authored code.
packages/

# Microsoft Store MSIX build output — large binaries, regenerated by build-msix.ps1.
dist-store/

# tauri icon also emits iOS/Android launcher icons; this app is Windows-only.
src-tauri/icons/android/
src-tauri/icons/ios/

# Staged inference sidecar + its ONNX Runtime DLL, built by
# scripts/vendor-sidecar.js for tauri.conf.json's externalBin. Build output
# with a target triple in the name, not authored source.
src-tauri/binaries/

# Perf harness output: one JSON per run, plus the isolated WebView2 profile a
# perf run uses so it cannot disturb the real install's localStorage. The
# committed reference numbers live in scripts/perf/baseline.json, which is NOT
# ignored — comparing against it is the whole point.
scripts/perf/runs/

# Local audio used for profiling and verification runs (diarization, beat
# tracking, Whisper). Commercial music — it is somebody else's copyright, this
# remote is public, and the files are tens of MB each. Nothing in the repo may
# depend on a specific track being present: point tests at a path via an env
# var (see sidecar/tests/real_transcription.rs) rather than committing audio.
songs/
