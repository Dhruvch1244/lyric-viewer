{
  "name": "lyric-overlay",
  "version": "0.8.0",
  "description": "Beat-aware synced lyric overlay for Windows. Detects any media app via SMTC.",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "probe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src/main/smtc-poll.ps1 -Once",
    "package": "electron-packager . LyricPlayer --platform=win32 --arch=x64 --out=dist --overwrite --asar=false --app-copyright=\"Lyric Player\" --ignore=\"^/dist\" --ignore=\"^/\\.gitignore\"",
    "dist:win": "electron-builder --win --x64"
  },
  "license": "MIT",
  "private": true,
  "author": "Dhruv Choudhary",
  "build": {
    "appId": "com.dhruv.lyricoverlay",
    "productName": "Lyric Overlay",
    "copyright": "Copyright © 2026 Dhruv Choudhary",
    "asar": false,
    "directories": {
      "output": "dist-installer",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.md",
      "!node_modules/onnxruntime-node/bin/napi-v6/darwin${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux${/*}",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/arm64${/*}",
      "!node_modules/@huggingface/transformers/dist/*.web.*",
      "!node_modules/onnxruntime-web${/*}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "LyricOverlay-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lyric Overlay",
      "uninstallDisplayName": "Lyric Overlay ${version}"
    }
  },
  "devDependencies": {
    "@electron/packager": "^20.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@huggingface/transformers": "^4.2.0",
    "wavefile": "^11.0.0"
  }
}
