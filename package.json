{
  "name": "lyric-overlay",
  "version": "0.46.0",
  "description": "Beat-aware synced lyric overlay for Windows. Detects any media app via SMTC.",
  "scripts": {
    "test": "node --test",
    "perf": "node scripts/perf/harness.mjs",
    "perf:baseline": "node scripts/perf/harness.mjs --baseline",
    "perf:build-release": "node scripts/perf/harness.mjs --build-release",
    "perf:startup": "node scripts/perf/startup.mjs",
    "probe": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File src-tauri/smtc-poll.ps1 -Once",
    "vendor:presets": "node scripts/vendor-presets.js",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "npm run vendor:sidecar && tauri build --config src-tauri/tauri.bundle.conf.json",
    "vendor:whisper": "node scripts/vendor-whisper.js",
    "vendor:demucs": "node scripts/vendor-demucs.js",
    "vendor:sidecar": "node scripts/vendor-sidecar.js",
    "icon": "node scripts/gen-icon.js"
  },
  "license": "MIT",
  "private": true,
  "author": "Dhruv Choudhary",
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@tauri-apps/api": "^2.11.1",
    "butterchurn": "^2.6.7",
    "butterchurn-presets": "^2.4.7"
  },
  "overrides": {
    "onnxruntime-web": "1.27.0"
  }
}
